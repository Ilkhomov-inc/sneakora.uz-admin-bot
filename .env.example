# ======================================================
# SNEAKORA TELEGRAM BOT CONFIGURATION
# ======================================================

# Токен вашего Telegram бота (получить в @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Выбор ИИ провайдера: gemini или openai
AI_PROVIDER=gemini

# ------------------------------------------------------
# Настройки Google Gemini (Бесплатный ключ на https://aistudio.google.com/)
# ------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------
# Настройки OpenAI (или OpenRouter, если используете его)
# ------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1  # если хотите использовать OpenRouter

# ------------------------------------------------------
# Настройки шаблона и магазина
# ------------------------------------------------------
SHOP_NAME=SNEAKORA
ADMIN_HANDLE=@sneakora_admin

# Режим отображения цены:
# placeholder - выводит "💰 Цена: ___$" (для удобного заполнения перед публикацией)
# omit        - полностью убирает строчку с ценой
PRICE_MODE=placeholder

# Размеры по умолчанию, если не указаны конкретные
DEFAULT_SIZES=Все размеры

# ------------------------------------------------------
# Безопасность (Опционально)
# ------------------------------------------------------
# Доступ к боту закрыт: новые пользователи подают заявку, админы одобряют её кнопкой.
# Telegram ID администраторов через запятую (получают заявки, команда /users):
ADMIN_IDS=
# Telegram ID сотрудников с постоянным доступом без заявки (необязательно):
ALLOWED_USERS=
